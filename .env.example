# ===========================================
# WattHarbor 单客户部署环境变量模板
# 复制为 .env 并填入实际配置，由 Docker Compose 读取。
# ===========================================

# ---------------- 数据库 ------------------
MYSQL_ROOT_PASSWORD=change-me-root-pw
# wattharbor 供生产迁移使用。
DB_PASSWORD=change-me-migration-pw
# 单体运行账号 wattharbor_app 只有数据读写权限。
# 密码会拼入 URL；可用 openssl rand -hex 32 生成安全字符串。
DB_APP_PASSWORD=change-me-app-pw
# 这些预算按数据库连接池生效。
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
# 生产启动时初始化 wattharbor 单库。连接 URL 由 Compose 生成。

# ---------------- Redis -------------------
# 缓存与持久事件流使用不同的 Redis 实例和密码。
REDIS_PASSWORD=change-me-cache-pw
REDIS_STREAM_PASSWORD=change-me-stream-pw

# ---------------- JWT / 内部通信 ------------
# openssl rand -hex 32  生成 64 字符 hex 串
# JWT_SECRET 用于会话；SERVICE_TOKEN 用于进程内接口。
JWT_SECRET=change-me-jwt-secret-64-hex-chars-please-rotate-quarterly
SERVICE_TOKEN=change-me-service-internal-token-also-64-hex-chars

# ---------------- 微信支付(商户号直连)-----
# AppID 用于微信登录、支付和退款。WECHAT_SECRET 用于登录及手机号授权。
# wechat_direct 的商户私钥需要通过只读挂载注入 app 容器。
# 生产使用微信登录；开发栈用 development 配合模拟支付。
LOGIN_MODE=wechat
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_app_secret
# 支付模式：disabled（关闭）、simulation（模拟）、wechat_direct（微信直连）。
# 真实支付验收完成前，生产保持 disabled。
PAYMENT_MODE=disabled
WECHAT_MCH_ID=your_merchant_id
WECHAT_APIV3_KEY=
# 商户证书序列号和 PEM 私钥（PKCS8 或 PKCS1）；私钥须只读挂载到容器内的指定路径。
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
# 微信支付平台证书由官方 SDK 管理。
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/public/payments/wechat/callback
WECHAT_REFUND_NOTIFY_URL=https://your-domain.com/api/v1/public/refund/wechat/callback
# 可选：小程序微信客服入口。
WECHAT_CUSTOMER_SERVICE_CORP_ID=

# ---------------- 预留: 监管报送 ------------
# 当前 Go 配置和后台任务未消费以下预留变量。
# disabled / simulation / http 是预留模式；修改值不会启用外部投递，尚未接入正式监管平台。
REGULATORY_MODE=disabled
REGULATORY_ENDPOINT=
REGULATORY_SIGNING_SECRET=

# ---------------- 客户域名 ------------------
PUBLIC_DOMAIN=charge.example.com
# Caddy → admin 专用隔离网络；避免与宿主机已有网段重叠，改网段时同步修改单一可信地址。
ADMIN_PROXY_SUBNET=172.30.82.0/24
CADDY_ADMIN_PROXY_IP=172.30.82.2
# 开发／非 Compose 启动可指定可信代理 IP/CIDR，逗号分隔；空值不信任转发头。
# 生产 Compose 自动使用上面的 Caddy 单一地址，不信任共享容器网段。
ADMIN_TRUSTED_PROXIES=
# 单体启动时读取后台初始化参数。
ADMIN_BOOTSTRAP_USER=admin
# 仅空后台账户表时初始化；明文环境变量由 Go 使用 bcrypt 哈希，生产请使用独立强密码
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Admin2026
ADMIN_BOOTSTRAP_PHONE=+8613800000000

# ---------------- 可选: 日志/可观测性 --------
# Go 服务向标准输出记录请求 ID 和服务错误。
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------- 可选: 计费规则默认值 -----
DEFAULT_TIME_OF_USE_JSON={"peak":{"start":"08:00","end":"21:00","rate_cents_per_kwh":80},"off":{"start":"21:00","end":"08:00","rate_cents_per_kwh":40}}

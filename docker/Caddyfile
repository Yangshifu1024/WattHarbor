{
    admin off
    log default {
        output stdout
        format json
    }
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=63072000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"

    # 服务间接口不对外：容器网络内直连，不经 Caddy。
    handle /api/v1/internal/* {
        respond 404
    }

    # 运营后台走独立进程。
    handle /api/v1/admin/* {
        reverse_proxy chargepilot-admin:8081
    }

    # 其余（C 端与支付回调）走 central。
    handle /api/* {
        reverse_proxy chargepilot-central:8080
    }

    handle_path /admin/* {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }

    redir / /admin/
}
